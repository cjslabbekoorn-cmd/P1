 "page_settings": {
  "hide_title": "yes",
  "custom_css": "/* Bedankpagina: de bestelling in dezelfde vormgeving als afrekenen (grijze vlakken, Spectral-koppen, Aptos).\n   Staat als Pagina-CSS in Elementor (Pagina-instellingen > Aangepaste CSS); \"selector\" is deze pagina. */\nselector .elementor-widget-woocommerce-purchase-summary h2,\nselector .elementor-widget-woocommerce-purchase-summary .woocommerce-column__title {\n\tfont-family: Spectral, serif; font-weight: 500; font-size: 24px; margin: 0 0 12px;\n}\nselector .elementor-widget-woocommerce-purchase-summary,\nselector .elementor-widget-woocommerce-purchase-summary table { font-family: aptos, sans-serif; font-size: 15px; }\n/* kerngegevens als rij vlakjes */\nselector .woocommerce-order-overview { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin: 0 0 20px; padding: 0; }\nselector .woocommerce-order-overview li { list-style: none; background: #f6f6f6; border: 0 !important; border-radius: 10px; padding: 14px 16px !important; margin: 0 !important; font-size: 13px; text-transform: none; color: var(--e-global-color-text); }\nselector .woocommerce-order-overview li strong { display: block; margin-top: 4px; font-size: 16px; color: var(--e-global-color-primary); }\n/* bestelregels: zonder kolomkoppen, product links en bedrag rechts */\nselector .woocommerce-table--order-details { border: 0 !important; border-collapse: separate; width: 100%; }\nselector .woocommerce-table--order-details th,\nselector .woocommerce-table--order-details td { border: 0 !important; padding: 8px 0 !important; background: transparent !important; }\nselector .woocommerce-table--order-details tfoot tr:last-child th,\nselector .woocommerce-table--order-details tfoot tr:last-child td { font-size: 18px; font-weight: 700; color: var(--e-global-color-primary); border-top: 1px solid #e3e3e3 !important; padding-top: 14px !important; }\nselector .wc-item-meta { margin: 4px 0 0; padding: 0; list-style: none; font-size: 13px; color: var(--e-global-color-text); }\nselector .wc-item-meta li p { display: inline; }\n/* bankgegevens (op factuur) duidelijk zichtbaar */\nselector .wc-bacs-bank-details-heading { color: var(--e-global-color-primary); }\nselector .wc-bacs-bank-details { list-style: none; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 8px 16px; }\nselector address { font-style: normal; line-height: 1.6; border: 0 !important; padding: 16px 20px !important; }\nselector .elementor-widget-woocommerce-purchase-summary a { color: var(--e-global-color-accent); }\nselector .woocommerce-order-overview li strong, selector .woocommerce-order-overview li .woocommerce-Price-amount { font-weight: 700; }\n/* \"Betaal je op factuur?\" alleen als de bestelling op factuur is: WooCommerce toont dan de bankgegevens */\nselector:not(:has(.wc-bacs-bank-details)) .sp-stap-factuur { display: none; }\nselector .sp-stap p { margin-bottom: 0; }\n"
 },
 "template": "elementor_header_footer"
