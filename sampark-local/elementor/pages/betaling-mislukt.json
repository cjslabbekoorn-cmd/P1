 "page_settings": {
  "hide_title": "yes",
  "custom_css": "/* Betaling mislukt: de bestelling (shortcode van de snippet betaling-mislukt) in de vormgeving van de bedankpagina.\n   Staat als Pagina-CSS in Elementor (Pagina-instellingen > Aangepaste CSS); \"selector\" is deze pagina. */\nselector .sp-mislukt { font-family: aptos, sans-serif; font-size: 15px; color: var(--e-global-color-text); }\nselector .sp-mislukt-gegevens { display: grid; grid-template-columns: repeat(auto-fit, minmax(150px, 1fr)); gap: 12px; margin: 0 0 16px; padding: 0; }\nselector .sp-mislukt-gegevens li { list-style: none; background: #fff; border-radius: 10px; padding: 14px 16px; font-size: 13px; }\nselector .sp-mislukt-gegevens li strong { display: block; margin-top: 4px; font-size: 16px; font-weight: 700; color: var(--e-global-color-primary); }\nselector .sp-mislukt-items { margin: 0 0 20px; line-height: 1.6; }\nselector .sp-mislukt-noot { margin: 10px 0 0; font-size: 14px; }\nselector .sp-stap p { margin-bottom: 0; }\n"
 },
 "template": "elementor_header_footer"
}